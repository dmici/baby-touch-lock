    <!-- Privacy & Accessibility Disclosure Dialog -->
    <string name="disclosure_dialog_title">एक्सेसिबिलिटी सेवा विवरण</string>
    <string name="disclosure_dialog_text">Baby Touch Lock केवल वीडियो देखते समय अनचाहे टच, जेस्चर और बटन को ब्लॉक करने के लिए Android एक्सेसिबिलिटी API का उपयोग करता है।\n\n🔒 100% स्थानीय और निजी: कोई भी स्क्रीन सामग्री या व्यक्तिगत डेटा कभी एकत्र या साझा नहीं किया जाता है।</string>
    <string name="dialog_ok">समझ गया</string>
    <string name="dialog_consent_agree">स्वीकार करें और आगे बढ़ें</string>
    <string name="dialog_consent_cancel">रद्द करें</string>

